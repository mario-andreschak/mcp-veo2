{
  "name": "mcp-video-generation-veo2",
  "version": "2.0.0",
  "description": "MCP server for Google Veo video and Gemini image generation",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-video-generation-veo2": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:package": "node scripts/test-package.mjs",
    "check": "npm run format:check && npm test && npm run test:package",
    "prepack": "npm run build",
    "format:check": "prettier --check src test scripts README.md package.json tsconfig.json .github/workflows/ci.yml"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mario-andreschak/mcp-veo2.git"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "@modelcontextprotocol/server-legacy": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "dotenv": "17.2.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0",
    "prettier": "3.6.2"
  }
}
