# Provider key stays on the server. Generation requires paid model access.
GOOGLE_API_KEY=
VIDEO_MODEL=veo-3.1-generate-preview
IMAGE_MODEL=gemini-3.1-flash-image
STORAGE_DIR=./generated-videos
HOST=127.0.0.1
PORT=3000
# Required for HTTP/SSE. Use a random value with at least 24 characters.
MCP_AUTH_TOKEN=
ALLOWED_HOSTS=
ALLOWED_ORIGINS=
IMAGE_URL_HOSTS=
GENERATION_TIMEOUT_MS=600000
POLL_INTERVAL_MS=10000
MAX_MEDIA_BYTES=67108864
